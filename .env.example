APP_NAME=tianxiadmin
ENV=local
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/tianxiadmin
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
# 配置加密密钥（Fernet），使用 Fernet.generate_key() 生成
CONFIG_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=[]
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
INITIAL_SUPERADMIN_USERNAME=superadmin
INITIAL_SUPERADMIN_PASSWORD=replace-with-a-strong-password
# 是否启用系统监控采样任务
MONITOR_ENABLED=true
# 系统监控采样间隔（秒）
MONITOR_SAMPLE_INTERVAL_SECONDS=60
# 系统监控指标保留天数，0 表示不清理
MONITOR_METRIC_RETENTION_DAYS=30
# 异常日志保留天数，0 表示不清理
EXCEPTION_LOG_RETENTION_DAYS=90
# 登录日志保留天数，0 表示不清理
LOGIN_LOG_RETENTION_DAYS=180
# 操作日志保留天数，0 表示不清理
AUDIT_LOG_RETENTION_DAYS=365
# Local asset storage. Production must use one API replica or mount the same
# durable MEDIA_ROOT on every replica; object storage is required before scaling out.
MEDIA_ROOT=media
MEDIA_URL_PATH=/media
SYSTEM_ASSET_MAX_BYTES=2097152
# 私有附件目录，不得与 MEDIA_ROOT 重叠
# FOLLOW_UP_ATTACHMENT_ROOT=attachments
# 单个跟进附件大小上限（字节）
# FOLLOW_UP_ATTACHMENT_MAX_BYTES=10485760
# 单条跟进记录附件数量上限
# FOLLOW_UP_ATTACHMENT_MAX_PER_RECORD=5
